# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Micro-SaaS Production Environment Variables
# ---------------------------------------------
# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:PASSWORD@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://postgres:PASSWORD@ep-sample.us-east-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth / Auth.js
NEXTAUTH_SECRET="your_openssl_rand_base64_32_secret"
NEXTAUTH_URL="https://subpulse.yourdomain.com"

# Resend Transactional Email API
RESEND_API_KEY="re_123456789_abcdef"
RESEND_FROM_EMAIL="alerts@subpulse.yourdomain.com"

# Vercel Cron Secret (protects /api/cron/renewals endpoint)
CRON_SECRET="your_long_random_hex_secret"
